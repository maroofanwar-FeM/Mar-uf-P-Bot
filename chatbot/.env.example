# Copy this file to ".env" (same folder) and set your own login credentials.
# The server reads this file on startup. It is never sent to the browser.
APP_USERNAME=your-username-here
APP_PASSWORD=your-password-here

# Free API key for the "Run" feature's replies — get one at console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the model (defaults to llama-3.3-70b-versatile if unset)
# GROQ_MODEL=llama-3.3-70b-versatile
